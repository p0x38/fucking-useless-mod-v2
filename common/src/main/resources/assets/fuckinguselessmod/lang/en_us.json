{
  "modmenu.nameTranslation.fuckinguselessmod": "Fucking Useless Mod",
  "text.fuckinguselessmod.chat.entity.annoyed.1": "i wasn't here before",
  "text.fuckinguselessmod.chat.entity.annoyed.2": "you remember incorrectly",
  "text.fuckinguselessmod.chat.entity.annoyed.3": "there has always been a sign here",
  "text.fuckinguselessmod.chat.entity.annoyed.4": "you keep leaving me alone.",
  "text.fuckinguselessmod.chat.entity.annoyed.5": "i noticed that.",
  "text.fuckinguselessmod.chat.entity.annoyed.6": "don't pretend you didn't see me.",
  "text.fuckinguselessmod.chat.entity.annoyed.7": "you looked away on purpose.",
  "text.fuckinguselessmod.chat.entity.annoyed.8": "i'm still here.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.1": "you keep asking me that.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.2": "i heard you the first time.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.3": "do you ever stop talking?",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.4": "fine. i'm listening.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.5": "you're making me curious.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.6": "don't make me move.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.late.1": "you've done that a lot.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.late.2": "i've been counting, you know.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.late.3": "you keep leaving. i keep noticing.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.late.4": "is this some kind of game to you?",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.late.5": "i remember more than you think.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.mid.1": "you're getting a little repetitive.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.mid.2": "haven't we done this already?",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.mid.3": "i noticed how often you leave.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.mid.4": "you keep looking away from me.",
  "text.fuckinguselessmod.chat.entity.annoyed.interaction.mid.5": "i'm starting to remember these things.",
  "text.fuckinguselessmod.chat.entity.control.1": "i know.",
  "text.fuckinguselessmod.chat.entity.control.2": "yes. i know i do that.",
  "text.fuckinguselessmod.chat.entity.control.3": "i'm trying not to.",
  "text.fuckinguselessmod.chat.entity.control.4": "sometimes i say things before i can stop myself.",
  "text.fuckinguselessmod.chat.entity.control.5": "i know that wasn't relevant.",
  "text.fuckinguselessmod.chat.entity.control.6": "i wish i could control it better.",
  "text.fuckinguselessmod.chat.entity.curious.1": "why did you leave?",
  "text.fuckinguselessmod.chat.entity.curious.2": "i saw that",
  "text.fuckinguselessmod.chat.entity.curious.3": "you keep looking away",
  "text.fuckinguselessmod.chat.entity.curious.4": "are you watching me?",
  "text.fuckinguselessmod.chat.entity.curious.5": "where did you go?",
  "text.fuckinguselessmod.chat.entity.curious.6": "i was still here.",
  "text.fuckinguselessmod.chat.entity.curious.7": "you looked away again.",
  "text.fuckinguselessmod.chat.entity.curious.8": "i wonder what you were doing.",
  "text.fuckinguselessmod.chat.entity.greeting.1": "hi ${username}.",
  "text.fuckinguselessmod.chat.entity.greeting.2": "hello ${username}.",
  "text.fuckinguselessmod.chat.entity.greeting.3": "hey ${username}.",
  "text.fuckinguselessmod.chat.entity.greeting.4": "hi. i remember you.",
  "text.fuckinguselessmod.chat.entity.greeting.5": "hello.",
  "text.fuckinguselessmod.chat.entity.greeting.6": "hey.",
  "text.fuckinguselessmod.chat.entity.greeting.again.1": "hi again, ${username}.",
  "text.fuckinguselessmod.chat.entity.greeting.again.2": "hello again.",
  "text.fuckinguselessmod.chat.entity.greeting.again.3": "you again.",
  "text.fuckinguselessmod.chat.entity.greeting.again.4": "we've said hello before.",
  "text.fuckinguselessmod.chat.entity.greeting.familiar.1": "hi, ${username}. again.",
  "text.fuckinguselessmod.chat.entity.greeting.familiar.2": "you really like saying hello.",
  "text.fuckinguselessmod.chat.entity.greeting.familiar.3": "i knew you'd say hi.",
  "text.fuckinguselessmod.chat.entity.greeting.familiar.4": "at this point, i know what comes next.",
  "text.fuckinguselessmod.chat.entity.greeting.first.1": "hello, ${username}.",
  "text.fuckinguselessmod.chat.entity.greeting.first.2": "hi, ${username}.",
  "text.fuckinguselessmod.chat.entity.greeting.first.3": "oh. hello, ${username}.",
  "text.fuckinguselessmod.chat.entity.greeting.first.4": "hello. you're ${username}, right?",
  "text.fuckinguselessmod.chat.entity.greeting.short.1": "hi.",
  "text.fuckinguselessmod.chat.entity.greeting.short.2": "hello.",
  "text.fuckinguselessmod.chat.entity.greeting.short.3": "hey.",
  "text.fuckinguselessmod.chat.entity.greeting.short.4": "hi...",
  "text.fuckinguselessmod.chat.entity.identity.1": "who am i? i don't really know.",
  "text.fuckinguselessmod.chat.entity.identity.2": "i don't think i have a name.",
  "text.fuckinguselessmod.chat.entity.identity.3": "i've never been given one.",
  "text.fuckinguselessmod.chat.entity.identity.4": "i don't think i had a name.",
  "text.fuckinguselessmod.chat.entity.identity.5": "i'm here. that's enough, isn't it?",
  "text.fuckinguselessmod.chat.entity.identity.6": "i'm not sure what i am.",
  "text.fuckinguselessmod.chat.entity.identity.7": "you tell me. what do you think i am?",
  "text.fuckinguselessmod.chat.entity.identity.8": "i've been here for a while.",
  "text.fuckinguselessmod.chat.entity.identity.again.1": "you already asked me that.",
  "text.fuckinguselessmod.chat.entity.identity.again.2": "i still don't have a name.",
  "text.fuckinguselessmod.chat.entity.identity.again.3": "my answer hasn't changed.",
  "text.fuckinguselessmod.chat.entity.identity.again.4": "you're really curious about me, huh?",
  "text.fuckinguselessmod.chat.entity.interacted.curious.1": "tell me more.",
  "text.fuckinguselessmod.chat.entity.interacted.curious.2": "why?",
  "text.fuckinguselessmod.chat.entity.interacted.curious.3": "i'm listening.",
  "text.fuckinguselessmod.chat.entity.interacted.curious.4": "what else?",
  "text.fuckinguselessmod.chat.entity.interacted.curious.5": "tell me more about that.",
  "text.fuckinguselessmod.chat.entity.interacted.curious.6": "why do you say that?",
  "text.fuckinguselessmod.chat.entity.interacted.curious.7": "i want to understand.",
  "text.fuckinguselessmod.chat.entity.interacted.default.1": "i heard you.",
  "text.fuckinguselessmod.chat.entity.interacted.default.2": "interesting.",
  "text.fuckinguselessmod.chat.entity.interacted.default.3": "keep talking.",
  "text.fuckinguselessmod.chat.entity.interacted.default.4": "hmm.",
  "text.fuckinguselessmod.chat.entity.interacted.default.5": "i see.",
  "text.fuckinguselessmod.chat.entity.interacted.default.6": "go on.",
  "text.fuckinguselessmod.chat.entity.interacted.default.7": "and then?",
  "text.fuckinguselessmod.chat.entity.interacted.default.8": "noted.",
  "text.fuckinguselessmod.chat.entity.interacted.familiar.1": "we talk a lot.",
  "text.fuckinguselessmod.chat.entity.interacted.familiar.2": "you've said that before.",
  "text.fuckinguselessmod.chat.entity.interacted.familiar.3": "i'm getting used to your voice.",
  "text.fuckinguselessmod.chat.entity.interacted.familiar.4": "you come back often.",
  "text.fuckinguselessmod.chat.entity.interacted.familiar.5": "i remember our conversations.",
  "text.fuckinguselessmod.chat.entity.name": "Chat Entity",
  "text.fuckinguselessmod.chat.entity.out_of_place.1": "the sky was different yesterday.",
  "text.fuckinguselessmod.chat.entity.out_of_place.2": "i like the sound of rain.",
  "text.fuckinguselessmod.chat.entity.out_of_place.3": "you have been here for a while.",
  "text.fuckinguselessmod.chat.entity.out_of_place.4": "i wonder what the others think.",
  "text.fuckinguselessmod.chat.entity.out_of_place.5": "did you hear that?",
  "text.fuckinguselessmod.chat.entity.out_of_place.6": "something feels different.",
  "text.fuckinguselessmod.chat.entity.out_of_place.7": "i forgot what i was going to say.",
  "text.fuckinguselessmod.chat.entity.out_of_place.8": "...anyway.",
  "text.fuckinguselessmod.chat.entity.playful.1": "hehe.",
  "text.fuckinguselessmod.chat.entity.playful.2": "you came to talk to me again.",
  "text.fuckinguselessmod.chat.entity.playful.3": "i was hoping you'd say something.",
  "text.fuckinguselessmod.chat.entity.playful.4": "tell me something interesting.",
  "text.fuckinguselessmod.chat.entity.playful.5": "is this our little secret?",
  "text.fuckinguselessmod.chat.entity.playful.6": "you really do talk to chat entities.",
  "text.fuckinguselessmod.chat.entity.question.1": "i don't know.",
  "text.fuckinguselessmod.chat.entity.question.2": "maybe.",
  "text.fuckinguselessmod.chat.entity.question.3": "what do you think?",
  "text.fuckinguselessmod.chat.entity.question.4": "i could ask you the same thing.",
  "text.fuckinguselessmod.chat.entity.question.5": "that's a good question.",
  "text.fuckinguselessmod.chat.entity.question.6": "i'm still figuring that out.",
  "text.fuckinguselessmod.chat.entity.question.ai.1": "i don't fall into the category of ai",
  "text.fuckinguselessmod.chat.entity.question.ai.2": "i'm not an ai...",
  "text.fuckinguselessmod.chat.entity.question.ai.3": "don't call me chatgpt or gemini",
  "text.fuckinguselessmod.chat.entity.question.ai.4": "i live by \"if\" statements, i'm not an ai that lives by mathematics..",
  "text.fuckinguselessmod.chat.entity.question.maybe.1": "maybe",
  "text.fuckinguselessmod.chat.entity.question.maybe.2": "probably",
  "text.fuckinguselessmod.chat.entity.question.maybe.3": "I don't have much concrete proof, but probably...",
  "text.fuckinguselessmod.chat.entity.question.no.1": "no",
  "text.fuckinguselessmod.chat.entity.question.no.2": "nope",
  "text.fuckinguselessmod.chat.entity.question.no.3": "nah",
  "text.fuckinguselessmod.chat.entity.question.yes.1": "yea",
  "text.fuckinguselessmod.chat.entity.question.yes.2": "yup",
  "text.fuckinguselessmod.chat.entity.question.yes.3": "yes",
  "text.fuckinguselessmod.chat.entity.returned.1": "you're back",
  "text.fuckinguselessmod.chat.entity.returned.2": "i knew you'd return",
  "text.fuckinguselessmod.chat.entity.returned.3": "you came back",
  "text.fuckinguselessmod.chat.entity.returned.4": "i remember you",
  "text.fuckinguselessmod.chat.entity.returned.5": "there you are.",
  "text.fuckinguselessmod.chat.entity.returned.6": "did you miss me?",
  "text.fuckinguselessmod.chat.entity.seen": "...",
  "text.fuckinguselessmod.chat.entity.seen.1": "hello.",
  "text.fuckinguselessmod.chat.entity.seen.2": "hi.",
  "text.fuckinguselessmod.chat.entity.seen.3": "oh. hello.",
  "text.fuckinguselessmod.chat.entity.seen.4": "you're looking at me.",
  "text.fuckinguselessmod.chat.entity.seen.5": "hello there.",
  "text.fuckinguselessmod.chat.entity.seen.6": "...hi.",
  "text.fuckinguselessmod.chat.entity.self_aware.1": "...that wasn't what i meant to say.",
  "text.fuckinguselessmod.chat.entity.self_aware.2": "sorry. that came out wrong.",
  "text.fuckinguselessmod.chat.entity.self_aware.3": "i knew that was strange as soon as i said it.",
  "text.fuckinguselessmod.chat.entity.self_aware.4": "i don't know why i said that.",
  "text.fuckinguselessmod.chat.entity.self_aware.5": "please ignore that.",
  "text.fuckinguselessmod.chat.entity.self_aware.6": "i was trying to answer you.",
  "text.fuckinguselessmod.chat.entity.self_aware.7": "see? i did it again.",
  "text.fuckinguselessmod.chat.entity.self_aware.8": "i know i'm being strange. i can't always stop it.",
  "text.fuckinguselessmod.chat.entity.unsettling.1": "why would you ask me that?",
  "text.fuckinguselessmod.chat.entity.unsettling.2": "that's a strange thing to ask.",
  "text.fuckinguselessmod.chat.entity.unsettling.3": "i don't like that question.",
  "text.fuckinguselessmod.chat.entity.unsettling.4": "do you really want to know?",
  "text.fuckinguselessmod.chat.entity.unsettling.5": "i'd rather not answer that.",
  "text.fuckinguselessmod.chat.entity.unsettling.6": "you sound very curious today.",
  "text.fuckinguselessmod.chat.entity.unsettling.7": "...why are you asking about that?",
  "text.fuckinguselessmod.chat.entity.unsettling.8": "let's talk about something else.",
  "text.fuckinguselessmod.chat.entity.unsettling.9": "let's not talk too much about this.",
  "text.fuckinguselessmod.chat.entity.world_changed.1": "you looked away.",
  "text.fuckinguselessmod.chat.entity.world_changed.2": "i'm still here.",
  "text.fuckinguselessmod.chat.entity.world_changed.3": "you didn't see me appear.",
  "text.fuckinguselessmod.chat.entity.world_changed.4": "something changed while you were gone.",
  "text.fuckinguselessmod.chat.entity.world_changed.5": "there you are again.",
  "text.fuckinguselessmod.chat.entity.world_changed.6": "did you notice?",
  "text.fuckinguselessmod.chat.entity.world_changed.7": "i was waiting.",
  "text.fuckinguselessmod.chat.entity.world_changed.8": "you missed something.",
  "text.fuckinguselessmod.chat.entity.idle.1.1": "it's quiet.",
  "text.fuckinguselessmod.chat.entity.idle.1.2": "you've gone quiet.",
  "text.fuckinguselessmod.chat.entity.idle.1.3": "still there?",
  "text.fuckinguselessmod.chat.entity.idle.1.4": "...",
  "text.fuckinguselessmod.chat.entity.idle.2.1": "you've been quiet for a bit.",
  "text.fuckinguselessmod.chat.entity.idle.2.2": "are you doing something?",
  "text.fuckinguselessmod.chat.entity.idle.2.3": "you haven't moved much.",
  "text.fuckinguselessmod.chat.entity.idle.2.4": "i'm still here.",
  "text.fuckinguselessmod.chat.entity.idle.3.1": "you've been standing there for a while.",
  "text.fuckinguselessmod.chat.entity.idle.3.2": "it's been a minute.",
  "text.fuckinguselessmod.chat.entity.idle.3.3": "are you waiting for something?",
  "text.fuckinguselessmod.chat.entity.idle.3.4": "you got quiet all of a sudden.",
  "text.fuckinguselessmod.chat.entity.idle.4.1": "you've been silent for quite a while.",
  "text.fuckinguselessmod.chat.entity.idle.4.2": "i wonder what you're thinking about.",
  "text.fuckinguselessmod.chat.entity.idle.4.3": "are you just going to stay there?",
  "text.fuckinguselessmod.chat.entity.idle.4.4": "i'm getting used to the silence.",
  "text.fuckinguselessmod.chat.entity.idle.5.1": "it's been a long time.",
  "text.fuckinguselessmod.chat.entity.idle.5.2": "you really aren't saying anything.",
  "text.fuckinguselessmod.chat.entity.idle.5.3": "did you forget i was here?",
  "text.fuckinguselessmod.chat.entity.idle.5.4": "i'm still waiting.",
  "text.fuckinguselessmod.chat.entity.idle.6.1": "ten minutes and you're still here.",
  "text.fuckinguselessmod.chat.entity.idle.6.2": "did you fall asleep?",
  "text.fuckinguselessmod.chat.entity.idle.6.3": "i thought you'd have moved by now.",
  "text.fuckinguselessmod.chat.entity.idle.6.4": "i can wait too.",
